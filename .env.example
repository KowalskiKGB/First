# Public HTTPS origin used by passkeys. Keep RP_ID equal to the hostname in ORIGIN.
RP_ID=first.rocketxsistemas.com.br
ORIGIN=https://first.rocketxsistemas.com.br
RP_NAME=First

# The first deployment stays open so the owner can create the initial passkey profile.
# Set to 1 after creating an admin profile and issuing invite codes.
INVITE_ONLY=0
ADMIN_UIDS=

SESSION_DAYS=30
VAPID_SUBJECT=https://first.rocketxsistemas.com.br

# Required in production: Dev panel user plus a scrypt hash (never plaintext).
# DEV_PANEL_USER must begin with first_dev_. Generate the hash out of band.
DEV_PANEL_USER=first_dev_admin
DEV_PANEL_PASSWORD_HASH=

# Optional. Enables encrypted AI provider configuration when set to exactly
# 32 random bytes encoded as 64 hexadecimal characters: openssl rand -hex 32
AI_CONFIG_MASTER_KEY=

# Required Basic Auth credential protecting the separately licensed /media/ paths.
# Generate with: htpasswd -nbs first-media 'a-long-random-password'
# FIRST_BOOTSTRAP_MIDDLEWARE additionally protects the whole host during owner registration.
FIRST_BASIC_AUTH_USERS=
FIRST_BOOTSTRAP_MIDDLEWARE=

# Used only with docker-compose.local.yml.
WEB_PORT=8080
