# Public HTTPS origin used by passkeys. Keep RP_ID equal to the hostname in ORIGIN.
RP_ID=first.rocketxsistemas.com.br
ORIGIN=https://first.rocketxsistemas.com.br
RP_NAME=First

# Safe production default. Use 0 only during a controlled first-account bootstrap,
# then restore 1 before exposing the host publicly.
INVITE_ONLY=1
ADMIN_UIDS=

SESSION_DAYS=30
VAPID_SUBJECT=https://first.rocketxsistemas.com.br

# Optional reverse-geocoding service. The URL host must also be allowlisted.
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=First gym directory/1.0 (+https://github.com/KowalskiKGB/First)
NOMINATIM_ALLOWED_HOSTS=nominatim.openstreetmap.org

# Required in production: Dev panel user plus a scrypt hash (never plaintext).
# DEV_PANEL_USER must start with first_dev_. The accepted hash format is
# scrypt:<base64url-salt>:<base64url-32-byte-hash>; use api/dev-auth.js.
DEV_PANEL_USER=
DEV_PANEL_PASSWORD_HASH=

# Optional for the core app, required before saving AI provider keys.
# Generate exactly 32 random bytes encoded as 64 hexadecimal characters.
AI_CONFIG_MASTER_KEY=

# Required by the Compose template for its optional whole-host bootstrap middleware.
# Generate with: htpasswd -nbs first-bootstrap 'a-long-random-password'
# /media/ uses the signed app session; FIRST_BOOTSTRAP_MIDDLEWARE may temporarily guard the host.
FIRST_BASIC_AUTH_USERS=
FIRST_BOOTSTRAP_MIDDLEWARE=

# Used only with docker-compose.local.yml.
WEB_PORT=8080
